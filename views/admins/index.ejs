<%
  const roleBadge   = { super_admin: 'badge-primary', content_editor: 'badge-info', moderator: 'badge-warning' };
  const statusBadge = { active: 'badge-success', disabled: 'badge-danger' };
%>

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between">
  <div>
    <h1>Admin Accounts</h1>
    <p>Super admins can edit the role, status and password of the other admins</p>
  </div>
  <a href="/auth/register" class="btn btn-primary">+ Add Admin</a>
</div>

<div class="card">
  <div class="card-header">
    <h2>Admins (<%= admins.length %>)</h2>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Admin</th>
          <th>Role</th>
          <th>Status</th>
          <th>Last Login</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (admins && admins.length > 0) { %>
          <% admins.forEach(function(a) { %>
            <% const isSelf = a.id === admin.id; %>
            <tr>
              <td>
                <div class="user-cell">
                  <div class="avatar-sm"><%= a.full_name.charAt(0).toUpperCase() %></div>
                  <div>
                    <div style="font-weight:500">
                      <%= a.full_name %>
                      <% if (isSelf) { %><span class="badge badge-secondary" style="margin-left:6px">You</span><% } %>
                    </div>
                    <div style="font-size:12px;color:var(--text-secondary)"><%= a.email %></div>
                  </div>
                </div>
              </td>
              <td><span class="badge <%= roleBadge[a.role] || '' %>"><%= a.role.replace('_', ' ') %></span></td>
              <td><span class="badge <%= statusBadge[a.status] || '' %>"><%= a.status %></span></td>
              <td style="font-size:13px;color:var(--text-secondary)">
                <%= a.last_login_at ? new Date(a.last_login_at).toLocaleString('en-US') : 'Never logged in' %>
              </td>
              <td style="font-size:13px;color:var(--text-secondary)">
                <%= new Date(a.created_at).toLocaleDateString('en-US') %>
              </td>
              <td>
                <% if (isSelf) { %>
                  <a href="/profile" class="btn btn-sm btn-secondary">My profile</a>
                <% } else { %>
                  <a href="/admins/<%= a.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="text-center">No data available</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
