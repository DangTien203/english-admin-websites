<div class="page-header">
  <h1>Edit Admin</h1>
  <p><a href="/admins">← Back to Admin Accounts</a></p>
</div>

<div style="max-width:560px">
  <div class="card">
    <div class="card-header"><h2>Account</h2></div>
    <div style="padding:20px">
      <p style="margin:0 0 16px;font-size:13px;color:var(--text-secondary)">
        Created <%= new Date(target.created_at).toLocaleDateString('en-US') %> ·
        Last login <%= target.last_login_at ? new Date(target.last_login_at).toLocaleString('en-US') : 'never' %>
      </p>

      <form action="/admins/<%= target.id %>/edit" method="POST" autocomplete="off">
        <div style="display:flex;flex-direction:column;gap:16px">
          <div class="form-group">
            <label>Full Name <span style="color:var(--danger)">*</span></label>
            <input type="text" name="full_name" value="<%= target.full_name %>" required minlength="2" maxlength="255">
          </div>
          <div class="form-group">
            <label>Email <span style="color:var(--danger)">*</span></label>
            <input type="email" name="email" value="<%= target.email %>" required maxlength="255">
            <small style="color:var(--text-secondary)">Changing the email changes how this admin signs in.</small>
          </div>
          <div class="form-group">
            <label>Role <span style="color:var(--danger)">*</span></label>
            <select name="role" required>
              <option value="super_admin"    <%= target.role === 'super_admin'    ? 'selected' : '' %>>Super admin</option>
              <option value="content_editor" <%= target.role === 'content_editor' ? 'selected' : '' %>>Content editor</option>
              <option value="moderator"      <%= target.role === 'moderator'      ? 'selected' : '' %>>Moderator</option>
            </select>
          </div>
          <div class="form-group">
            <label>Status <span style="color:var(--danger)">*</span></label>
            <select name="status" required>
              <option value="active"   <%= target.status === 'active'   ? 'selected' : '' %>>Active</option>
              <option value="disabled" <%= target.status === 'disabled' ? 'selected' : '' %>>Disabled (cannot sign in)</option>
            </select>
          </div>

          <div style="border-top:1px solid var(--border);padding-top:16px">
            <h3 style="margin:0 0 4px;font-size:15px">Reset password</h3>
            <p style="margin:0 0 12px;font-size:13px;color:var(--text-secondary)">Leave both boxes empty to keep the current password.</p>
            <div style="display:flex;flex-direction:column;gap:16px">
              <div class="form-group">
                <label>New password</label>
                <input type="password" name="new_password" minlength="6" maxlength="72" autocomplete="new-password">
              </div>
              <div class="form-group">
                <label>Confirm new password</label>
                <input type="password" name="confirm_password" minlength="6" maxlength="72" autocomplete="new-password">
              </div>
            </div>
          </div>

          <p style="margin:0;font-size:13px;color:var(--text-secondary)">
            If the role, status, email or password changes, this admin is signed out and must sign in again.
          </p>

          <div style="display:flex;gap:8px">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/admins" class="btn btn-secondary">Cancel</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
