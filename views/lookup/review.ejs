<div class="page-header">
  <h1>Duyệt mục từ tự tạo</h1>
  <p>Mục từ do job làm giàu tạo ra (ghi chú bắt đầu bằng <code>[auto]</code>): xem nghĩa tiếng Việt, rồi xuất bản hoặc ẩn</p>
</div>

<%- include('_tabs', { section }) %>

<% if (!canWrite) { %>
  <p class="lk-muted" style="margin-bottom:16px">Tài khoản của bạn chỉ có quyền xem: các nút Xuất bản, Ẩn và Sửa không hiện.</p>
<% } %>

<!-- Filters -->
<div class="card" style="padding:16px;margin-bottom:20px">
  <form method="GET" action="/lookup/review" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
    <div class="form-group" style="margin:0;min-width:160px">
      <label style="font-size:12px">Trạng thái</label>
      <select name="status">
        <option value="pending"   <%= filters.status === 'pending'   ? 'selected' : '' %>>Chờ duyệt</option>
        <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Đã xuất bản</option>
        <option value="all"       <%= filters.status === 'all'       ? 'selected' : '' %>>Tất cả</option>
      </select>
    </div>
    <div class="form-group" style="margin:0;flex:1;min-width:180px">
      <label style="font-size:12px">Tìm theo từ</label>
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Từ hoặc dạng gốc...">
    </div>
    <div style="display:flex;gap:8px">
      <button type="submit" class="btn btn-primary">Lọc</button>
      <a href="/lookup/review" class="btn btn-secondary">Xóa lọc</a>
    </div>
  </form>
</div>

<div class="lk-split">
  <!-- Left: the list -->
  <div class="card">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap">
      <h2>Danh sách (<%= lk.num(pagination.total) %>)</h2>
      <% if (canWrite) { %>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <label class="lk-muted" style="display:flex;gap:6px;align-items:center;cursor:pointer">
            <input type="checkbox" id="lk-select-all"> Chọn các mục đủ điều kiện
          </label>
          <button type="button" id="lk-bulk-publish" class="btn btn-sm btn-primary" data-max="<%= maxBulk %>" disabled>Xuất bản hàng loạt (<span id="lk-selected-count">0</span>)</button>
        </div>
      <% } %>
    </div>
    <% if (canWrite) { %>
      <div class="lk-muted" style="padding:0 20px 8px">
        Chỉ chọn được mục từ chưa xuất bản, đủ trường bắt buộc và không có ghi chú cần xem của Haiku (tối đa <%= maxBulk %> mục mỗi lần). Mục khác: mở chi tiết rồi xuất bản từng mục.
      </div>
    <% } %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <% if (canWrite) { %><th style="width:32px"></th><% } %>
            <th>Từ</th>
            <th>Nghĩa tiếng Việt</th>
          </tr>
        </thead>
        <tbody id="lk-entry-rows">
          <% if (entries.length === 0) { %>
            <tr><td colspan="<%= canWrite ? 3 : 2 %>" class="text-center" style="padding:40px;color:var(--text-secondary)">Không có mục từ nào</td></tr>
          <% } %>
          <% entries.forEach(function(e) { %>
            <tr class="lk-list-item <%= e.id === selectedId ? 'selected' : '' %>" data-lk-entry="<%= e.id %>">
              <% if (canWrite) { %>
                <td>
                  <% if (e.eligible_for_bulk_publish) { %>
                    <input type="checkbox" class="lk-select" value="<%= e.id %>" aria-label="Chọn <%= e.headword %>">
                  <% } else { %>
                    <span class="lk-muted" title="<%= e.published ? 'Đã xuất bản' : (!e.tier_a_complete ? 'Thiếu trường bắt buộc (tầng A)' : 'Có ghi chú cần xem của Haiku') %>">—</span>
                  <% } %>
                </td>
              <% } %>
              <td>
                <div style="font-weight:600"><%= e.headword %></div>
                <div class="lk-muted">
                  <%= (e.pos || []).join(', ') %><% if (e.cefr_level) { %> · <%= e.cefr_level %><% } %> · <%= e.sense_count %> nghĩa
                </div>
                <div style="margin-top:4px;display:flex;gap:4px;flex-wrap:wrap">
                  <% if (filters.status === 'all') { %><span class="badge <%= e.published ? 'badge-success' : 'badge-warning' %>" style="font-size:11px"><%= e.published ? 'Đã xuất bản' : 'Chờ duyệt' %></span><% } %>
                  <% if (!e.tier_a_complete) { %><span class="badge badge-danger" style="font-size:11px" title="Thiếu: <%= e.tier_a_missing.join(', ') %>">thiếu tầng A</span><% } %>
                  <% if (e.review_note_count > 0) { %><span class="badge badge-warning" style="font-size:11px" title="Ghi chú cần xem của Haiku"><%= e.review_note_count %> ghi chú</span><% } %>
                </div>
              </td>
              <td style="font-size:13px"><%= e.meaning_vi %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { pagination }) %>
  </div>

  <!-- Right: the detail of the selected entry -->
  <div class="card lk-detail-pane" id="lk-detail-pane" data-can-write="<%= canWrite ? '1' : '0' %>">
    <% if (entry) { %>
      <%- include('entry-detail', { entry, canWrite, lk }) %>
    <% } else { %>
      <div style="padding:60px 20px;text-align:center;color:var(--text-secondary)">Chọn một mục từ ở bên trái để xem chi tiết</div>
    <% } %>
  </div>
</div>

<script src="/js/lookup-admin.js"></script>
