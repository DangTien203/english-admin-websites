# ── Server ──
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_learning_app
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Session ──
SESSION_SECRET=thay-bang-chuoi-bat-ky-dai-va-ngau-nhien

# ── Word lookup + dictionary self-enrichment (docs/lookup-spec.md §1) ──
# Booleans accept only true / false. Blank value = use the default shown.
# Kill switches
TRANSLATION_FALLBACK_ENABLED=true
ENRICHMENT_ENABLED=false
ENRICHMENT_WORKER_ENABLED=true
# auto = publish when tier A is complete; review = always create as unpublished
ENRICHMENT_PUBLISH_POLICY=auto

# Fast lookup path
LOOKUP_UPSTREAM_TIMEOUT_MS=2500
LOOKUP_TOTAL_DEADLINE_MS=3000
LOOKUP_MAX_MEANINGS=4
LOOKUP_TRANSLATE_DEFINITIONS=true
# google (default) = Google "word: definition" technique; haiku = ONE Claude Haiku call in parallel with
# Free Dictionary (needs ANTHROPIC_API_KEY). Haiku errors/timeouts fall back to google automatically.
LOOKUP_FAST_TRANSLATOR=google
LOOKUP_MISS_RATE_LIMIT_PER_MIN=20

# Google Translate (blank key = Google disabled)
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_BASE_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_MONTHLY_CHAR_LIMIT=450000
GOOGLE_TRANSLATE_MAX_DEFINITION_CHARS=160

# Free Dictionary API (no key)
FREE_DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en
FREE_DICTIONARY_MAX_REQUESTS_PER_5MIN=400

# Anthropic (required when ENRICHMENT_ENABLED=true)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ENRICH=claude-haiku-5-5
ANTHROPIC_MAX_OUTPUT_TOKENS_ENRICH=4000
ANTHROPIC_TIMEOUT_MS_ENRICH=60000

# Datamuse (blank key = unauthenticated; a key is expected from 2027-01-01)
DATAMUSE_ENABLED=true
DATAMUSE_BASE_URL=https://api.datamuse.com
DATAMUSE_API_KEY=

# Job queue (pg-boss) and limits
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5
ENRICHMENT_WORKER_CONCURRENCY=2
ENRICHMENT_JOB_RETRY_LIMIT=3
ENRICHMENT_JOB_RETRY_DELAY_SECONDS=30
ENRICHMENT_MAX_JOBS_PER_DAY=500

# Circuit breaker (per upstream provider)
UPSTREAM_BREAKER_FAILURE_THRESHOLD=5
UPSTREAM_BREAKER_RESET_MS=30000

# Optional separate database for the large ref_* tables (blank = main database).
# See docs/lookup-refdata.md.
REFDATA_DATABASE_URL=
